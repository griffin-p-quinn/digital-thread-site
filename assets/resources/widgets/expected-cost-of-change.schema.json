{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siemens.example/schemas/expected-cost-of-change.schema.json",
  "title": "Expected Cost of Change Model Output",
  "type": "object",
  "required": ["scenarios"],
  "properties": {
    "schemaVersion": { "type": "string", "default": "1.0" },
    "title": { "type": "string", "default": "Expected cost of change" },
    "subtitle": { "type": "string" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3, "default": "USD" },
    "locale": { "type": "string", "default": "en-US" },
    "defaultScenarioId": { "type": "string" },
    "disclaimer": { "type": "string" },
    "metadata": {
      "type": "object",
      "properties": {
        "modelName": { "type": "string" },
        "modelVersion": { "type": "string" },
        "predictedAt": { "type": "string" },
        "trainingWindow": { "type": "string" },
        "similarChanges": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["id", "label", "expectedCost", "drivers"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "badge": { "type": "string" },
        "expectedCost": { "type": "number", "minimum": 0 },
        "range": {
          "type": "object",
          "properties": {
            "low": { "type": "number", "minimum": 0 },
            "p50": { "type": "number", "minimum": 0 },
            "high": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "confidence": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 100 },
            {
              "type": "object",
              "required": ["score"],
              "properties": {
                "score": { "type": "number", "minimum": 0, "maximum": 100 },
                "label": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        },
        "interpretation": { "type": "string" },
        "scheduleRisk": {
          "type": "object",
          "required": ["upliftPercent"],
          "properties": {
            "label": { "type": "string" },
            "upliftPercent": { "type": "number", "exclusiveMinimum": 0, "maximum": 500 },
            "description": { "type": "string" }
          },
          "additionalProperties": false
        },
        "drivers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "amount"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string", "minLength": 1 },
              "amount": { "type": "number", "minimum": 0 },
              "detail": { "type": "string" },
              "category": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["label"],
                "properties": {
                  "label": { "type": "string" },
                  "value": { "type": "string" },
                  "source": { "type": "string" },
                  "impact": { "enum": ["low", "medium", "high"] }
                },
                "additionalProperties": true
              }
            ]
          }
        }
      },
      "additionalProperties": true
    }
  }
}
